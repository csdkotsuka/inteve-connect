# ==========================================
# INTEVE CONNECT - 環境変数設定一覧
# ==========================================

# 1. Supabase 設定（データベース & 認証）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2. LINE 厳格認証 & LIFF 設定（LINE Developersで取得）
# LINE Front-end Framework アプリID（例: 2001234567-AbcdEfgh）
VITE_LIFF_ID=

# LINE Login チャネル情報
VITE_LINE_CHANNEL_ID=
VITE_LINE_CHANNEL_SECRET=

# LINE Messaging API（予約リマインド・通知配信を利用する場合）
VITE_LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# 3. Google Apps Script / Google カレンダー同期連携（オプション）
VITE_GAS_API_URL=
