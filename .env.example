# ==========================================
# INTEVE CONNECT - 環境変数設定一覧
# ==========================================
# 【重要】VITE_ プレフィックスの変数は全てブラウザのJavaScriptバンドルに公開されます。
# サーバーサイドのみで扱うべき秘密鍵（シークレット）は絶対に VITE_ を付けないでください。

# 1. Supabase 設定（データベース & 認証）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2. LINE 厳格認証 & LIFF 設定（LINE Developersで取得）
# LINE Front-end Framework アプリID（例: 2001234567-AbcdEfgh）
VITE_LIFF_ID=

# LINE Login チャネルID（フロントエンドから使用する公開情報のみ）
VITE_LINE_CHANNEL_ID=

# ─────────────────────────────────────────────────────────
# ⚠️ 以下はサーバー側（GAS）にのみ設定し、.env には絶対に書かないこと！
# ⚠️ GASのスクリプトエディタ →「プロジェクトのプロパティ」→「スクリプトのプロパティ」に設定：
#    - LINE_CHANNEL_SECRET    … LINE Webhook署名検証用シークレット
#    - LINE_CHANNEL_ACCESS_TOKEN … LINE Messaging API 長期アクセストークン
#    - GAS_API_SECRET         … GAS APIアクセス制御用の共有シークレット
#    - SUPABASE_KEY           … SupabaseのAnon Key（または Service Role Key）
# ─────────────────────────────────────────────────────────

# 3. Google Apps Script APIシークレット（フロントエンドからGAS APIを叩く際に使用）
# GASの「スクリプトのプロパティ」の GAS_API_SECRET と一致する値を設定する
VITE_GAS_API_SECRET=

# 4. Google Apps Script URL
VITE_GAS_API_URL=
